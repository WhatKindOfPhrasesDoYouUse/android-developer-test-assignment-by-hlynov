<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="55dp"
        android:gravity="start"
        android:text="@string/app_title"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/underlineView"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#B77DED"
        app:layout_constraintStart_toStartOf="@+id/titleTextView"
        app:layout_constraintEnd_toEndOf="@+id/titleTextView"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView" />


    <TextView
        android:id="@+id/serviceInfoTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/service_info"
        android:textSize="16sp"
        android:textColor="#7B7B7B"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/underlineView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/sampleImage"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/artist"
        android:scaleType="centerCrop"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/artist_image"
        app:layout_constraintTop_toBottomOf="@+id/serviceInfoTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/biographyButton"
        android:layout_width="288dp"
        android:layout_height="55dp"
        android:text="@string/artist_biography_button"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/sampleImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/tracksButton"
        android:layout_width="288dp"
        android:layout_height="55dp"
        android:text="@string/best_tracks_button"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/biographyButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>