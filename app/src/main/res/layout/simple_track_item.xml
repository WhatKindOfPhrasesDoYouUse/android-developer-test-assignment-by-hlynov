<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp">

    <!-- Изображение трека -->
    <ImageView
        android:id="@+id/trackImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="#D3D3D3"
        android:contentDescription="@string/artist_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Название трека -->
    <TextView
        android:id="@+id/trackNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/track_field_base_text"
        android:textColor="#222222"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/trackImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/trackImage"
        android:layout_marginStart="12dp" />

    <!-- Имя артиста -->
    <TextView
        android:id="@+id/artistTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/track_field_base_text"
        android:textColor="#666666"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/trackNameTextView"
        app:layout_constraintStart_toStartOf="@id/trackNameTextView"
        app:layout_constraintEnd_toEndOf="@id/trackNameTextView"
        android:layout_marginTop="4dp" />

    <!-- Ранг -->
    <TextView
        android:id="@+id/rankTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/track_field_base_text"
        android:textColor="#888888"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/artistTextView"
        app:layout_constraintStart_toStartOf="@id/artistTextView"
        android:layout_marginTop="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
